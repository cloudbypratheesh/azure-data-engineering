{
	"name": "PL_Ingest_SQLTable_To_ADLS",
	"properties": {
		"activities": [
			{
				"name": "LKP_GetWatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n'EXEC usp_GetWatermark @ConfigID = ',\nstring(pipeline().parameters.P_ConfigID)\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_ETL_FRAMEWORK",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "CPY_SQLTable_To_ADLS",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SET_LastWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@if(equals(pipeline().parameters.P_LoadType,'FULL'),\nconcat('Select * from ',pipeline().parameters.P_SourceSchema,'.',pipeline().parameters.P_SourceTable),\nconcat('Select * from ',pipeline().parameters.P_SourceSchema,'.',pipeline().parameters.P_SourceTable,' where ',pipeline().parameters.P_WatermarkColumn,'>',variables('V_LastWatermark'))\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_SQL",
						"type": "DatasetReference",
						"parameters": {
							"P_SchemaName": {
								"value": "@pipeline().parameters.P_SourceSchema",
								"type": "Expression"
							},
							"P_TableName": {
								"value": "@pipeline().parameters.P_SourceTable",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"P_FolderPath": "@concat(pipeline().parameters.P_SourceSchema,'/',pipeline().parameters.P_SourceTable)",
							"P_FileName": "@concat(pipeline().parameters.P_SourceTable,'.parquet')"
						}
					}
				]
			},
			{
				"name": "SET_LastWatermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LKP_GetWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "V_LastWatermark",
					"value": {
						"value": "@string(activity('LKP_GetWatermark').output.firstRow.LastWatermark)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"P_ConfigID": {
				"type": "string"
			},
			"P_SourceSchema": {
				"type": "string"
			},
			"P_SourceTable": {
				"type": "string"
			},
			"P_LoadType": {
				"type": "string"
			},
			"P_WatermarkColumn": {
				"type": "string"
			},
			"P_TargetLayer": {
				"type": "string"
			},
			"P_FileFormat": {
				"type": "string"
			}
		},
		"variables": {
			"V_LastWatermark": {
				"type": "String"
			},
			"V_Test_ConfigID": {
				"type": "String"
			}
		},
		"annotations": []
	}
}